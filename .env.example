# Shared Postgres (same instance as nuwa). NOTE: when copying nuwa's URL,
# remove Prisma's `?schema=public` query param — psycopg/asyncpg reject it. In deployed environments use the
# dedicated phalo role (see README §Database access) — never nuwa's app role.
PHALO_DATABASE_URL=postgresql://user:password@localhost:5432/ayana

# Static shared secret for the internal API (nuwa -> phalo). Generate with:
#   openssl rand -hex 32
PHALO_SERVICE_TOKEN=change-me

PHALO_ENVIRONMENT=development
